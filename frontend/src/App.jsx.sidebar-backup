function StatCard({
  title,
  value,
  change,
  positive,
  icon: Icon,
  iconClass,
  description,
}) {
  return (
    <article className="stat-card">
      <div className="stat-top">
        <span className="stat-title">{title}</span>
        <div className={`stat-icon ${iconClass}`}>
          <Icon size={20} strokeWidth={1.8} />
        </div>
      </div>

      <div className="stat-value">{value}</div>

      <div className="stat-bottom">
        <span className={`stat-change ${positive ? "positive" : "neutral"}`}>
          {positive ? (
            <ArrowUpRight size={15} />
          ) : (
            <Clock3 size={14} />
          )}
          {change}
        </span>
        <span className="stat-description">{description}</span>
      </div>
    </article>
  );
}

function PaymentChart() {
  const maxValue = Math.max(...chartData.map((item) => item.value));

  const points = chartData
    .map((item, index) => {
      const x = 20 + index * 60;
      const y = 150 - (item.value / maxValue) * 115;
      return `${x},${y}`;
    })
    .join(" ");

  const areaPoints = `20,160 ${points} 380,160`;

  return (
    <div className="chart-card">
      <div className="card-heading">
        <div>
          <h2>Payment activity</h2>
          <p>Overview of your payment volume</p>
        </div>

        <select className="period-select" defaultValue="week">
          <option value="week">This week</option>
          <option value="month">This month</option>
          <option value="year">This year</option>
        </select>
      </div>

      <div className="chart-summary">
        <strong>KSh 84,650</strong>
        <span className="chart-growth">
          <ArrowUpRight size={15} /> 12.8%
        </span>
        <span className="chart-summary-label">compared with last week</span>
      </div>

      <div className="chart-container">
        <div className="chart-y-labels">
          <span>100k</span>
          <span>75k</span>
          <span>50k</span>
          <span>25k</span>
          <span>0</span>
        </div>

        <div className="chart-main">
          <div className="chart-grid">
            <span />
            <span />
            <span />
            <span />
            <span />
          </div>

          <svg
            className="payment-chart"
            viewBox="0 0 400 170"
            preserveAspectRatio="none"
            role="img"
            aria-label="Illustrative payment activity chart for Monday to Sunday"
          >
            <defs>
              <linearGradient id="chartFill" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stopColor="#15966b" stopOpacity=".20" />
                <stop offset="100%" stopColor="#15966b" stopOpacity="0" />
              </linearGradient>
            </defs>

            <polygon points={areaPoints} fill="url(#chartFill)" />

            <polyline
              points={points}
              fill="none"
              stroke="#13865f"
              strokeWidth="3"
              strokeLinecap="round"
              strokeLinejoin="round"
              vectorEffect="non-scaling-stroke"
            />

            {chartData.map((item, index) => (
              <circle
                key={item.day}
                cx={20 + index * 60}
                cy={150 - (item.value / maxValue) * 115}
                r="4"
                fill="#ffffff"
                stroke="#13865f"
                strokeWidth="2.5"
                vectorEffect="non-scaling-stroke"
              />
            ))}
          </svg>

          <div className="chart-x-labels">
            {chartData.map((item) => (
              <span key={item.day}>{item.day}</span>
            ))}
          </div>
        </div>
      </div>

      <div className="chart-legend">
        <span className="legend-dot" />
        Payment volume
        <span className="chart-legend-note">Illustrative demo data</span>
      </div>
    </div>
  );
}

