/* =========================================================
   PAYBIZ — PREMIUM FINTECH DASHBOARD
   Main application styles
   ========================================================= */

:root {
  font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI",
    sans-serif;
  color: #172a23;
  background: #f7f9f7;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;

  --green-950: #103d2e;
  --green-900: #124b36;
  --green-800: #176448;
  --green-700: #16805a;
  --green-600: #19966a;
  --green-100: #e6f5ed;
  --green-50: #f1faf5;

  --text-primary: #172a23;
  --text-secondary: #75827b;
  --border: #e8ece9;
  --surface: #ffffff;
  --background: #f7f9f7;
}

/* Base */

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  min-width: 320px;
  min-height: 100vh;
}

button,
input,
select {
  font: inherit;
}

button {
  cursor: pointer;
}

button:focus-visible,
input:focus-visible,
select:focus-visible {
  outline: 3px solid #a8ddc2;
  outline-offset: 3px;
}

button:disabled {
  cursor: not-allowed;
  opacity: 0.6;
}

/* Main layout */

#root {
  min-height: 100vh;
}

.app-shell {
  min-height: 100vh;
}

.sidebar {
  position: fixed;
  inset: 0 auto 0 0;
  z-index: 30;
  display: flex;
  flex-direction: column;
  width: 248px;
  padding: 27px 18px 18px;
  color: #d9e9df;
  background: var(--green-950);
}

.main-shell {
  min-height: 100vh;
  margin-left: 248px;
}

.page-content {
  width: 100%;
  max-width: 1700px;
  margin: 0 auto;
  padding: 34px 38px 24px;
}

/* Brand */

.brand {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 0 9px;
  margin-bottom: 46px;
}

.brand-mark {
  display: grid;
  flex-shrink: 0;
  width: 43px;
  height: 43px;
  place-items: center;
  color: #ffffff;
  background: #16805a;
  border: 1px solid #369a74;
  border-radius: 13px;
}

.brand-name {
  display: block;
  color: #ffffff;
  font-size: 23px;
  font-weight: 750;
  letter-spacing: -1px;
}

.brand-caption {
  display: block;
  margin-top: 4px;
  color: #9dbca9;
  font-size: 9px;
  font-weight: 650;
  letter-spacing: 1.35px;
}

/* Sidebar navigation */

.sidebar-label {
  padding: 0 12px;
  margin-bottom: 12px;
  color: #8eafa0;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 1.4px;
}

.navigation {
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.nav-item {
  display: flex;
  align-items: center;
  width: 100%;
  min-height: 45px;
  gap: 12px;
  padding: 0 12px;
  color: #c0d5c9;
  background: transparent;
  border: 1px solid transparent;
  border-radius: 9px;
  text-align: left;
  font-size: 13px;
  font-weight: 500;
  transition:
    background 160ms ease,
    color 160ms ease;
}

.nav-item:hover {
  color: #ffffff;
  background: rgb(255 255 255 / 7%);
}

.nav-item.nav-active {
  color: #ffffff;
  background: #216b4c;
  border-color: rgb(255 255 255 / 8%);
  font-weight: 650;
}

.nav-count {
  display: grid;
  width: 23px;
  height: 22px;
  margin-left: auto;
  place-items: center;
  color: #d8f5e5;
  background: rgb(255 255 255 / 12%);
  border-radius: 6px;
  font-size: 11px;
}

.sidebar-bottom {
  margin-top: auto;
}

.security-card {
  display: flex;
  align-items: center;
  gap: 11px;
  padding: 13px 11px;
  margin-bottom: 19px;
  background: rgb(255 255 255 / 5%);
  border: 1px solid rgb(255 255 255 / 10%);
  border-radius: 11px;
}

.security-icon {
  display: grid;
  flex-shrink: 0;
  width: 34px;
  height: 34px;
  place-items: center;
  color: #a6e7c3;
  background: rgb(40 165 104 / 17%);
  border-radius: 9px;
}

.security-card strong {
  display: block;
  color: #eff8f2;
  font-size: 11px;
}

.security-card p {
  margin: 5px 0 0;
  color: #a0bcae;
  font-size: 10px;
}

.sidebar-footer {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 17px 7px 2px;
  margin-top: 17px;
  color: #a7c0b2;
  border-top: 1px solid rgb(255 255 255 / 11%);
  font-size: 10px;
}

.footer-dot,
.environment-dot,
.welcome-dot {
  display: inline-block;
  width: 7px;
  height: 7px;
  flex-shrink: 0;
  background: #4cc58b;
  border-radius: 50%;
}

.version {
  margin-left: auto;
  color: #829e8e;
}

/* Top navigation */

.topbar {
  position: sticky;
  top: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 75px;
  padding: 0 38px;
  background: rgb(255 255 255 / 96%);
  border-bottom: 1px solid var(--border);
  backdrop-filter: blur(12px);
}

.topbar-left,
.topbar-actions {
  display: flex;
  align-items: center;
}

.breadcrumbs {
  display: flex;
  align-items: center;
  gap: 12px;
  color: #89958e;
  font-size: 12px;
}

.breadcrumb-divider {
  color: #c4ccc7;
}

.breadcrumbs strong {
  color: #293d32;
  font-weight: 650;
}

.topbar-actions {
  gap: 21px;
}

.environment {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 8px 11px;
  color: #597367;
  background: #f3f8f4;
  border: 1px solid #e5eee7;
  border-radius: 7px;
  font-size: 10px;
  font-weight: 550;
}

.environment-dot {
  width: 6px;
  height: 6px;
}

.icon-button {
  position: relative;
  display: grid;
  flex-shrink: 0;
  width: 38px;
  height: 38px;
  padding: 0;
  place-items: center;
  color: #617168;
  background: transparent;
  border: 1px solid transparent;
  border-radius: 9px;
  transition:
    background 160ms ease,
    border-color 160ms ease;
}

.icon-button:hover {
  background: #f3f7f4;
  border-color: #e8eee9;
}

.notification-dot {
  position: absolute;
  top: 8px;
  right: 8px;
  width: 7px;
  height: 7px;
  background: #dc695c;
  border: 1px solid #ffffff;
  border-radius: 50%;
}

.topbar-divider {
  width: 1px;
  height: 32px;
  background: #e9edea;
}

.profile-button {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 4px 0;
  color: inherit;
  background: transparent;
  border: 0;
  text-align: left;
}

.avatar {
  display: grid;
  flex-shrink: 0;
  width: 33px;
  height: 33px;
  place-items: center;
  color: #287653;
  background: #e9f4ec;
  border: 1px solid #dcecdf;
  border-radius: 50%;
  font-size: 10px;
  font-weight: 700;
}

.avatar-admin {
  width: 37px;
  height: 37px;
  color: #ffffff;
  background: var(--green-800);
  border: 0;
}

.profile-info strong,
.profile-info span {
  display: block;
}

.profile-info strong {
  color: #27392f;
  font-size: 12px;
  font-weight: 650;
}

.profile-info span {
  margin-top: 4px;
  color: #89958e;
  font-size: 10px;
}

.profile-button > svg {
  color: #849187;
}

.mobile-menu {
  display: none;
}

/* Welcome section */

.welcome-row {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 24px;
}

.eyebrow {
  display: flex;
  align-items: center;
  gap: 8px;
  color: #658273;
  font-size: 9px;
  font-weight: 750;
  letter-spacing: 1.35px;
}

.welcome-dot {
  width: 6px;
  height: 6px;
}

.welcome-row h1,
.placeholder-page h1 {
  margin: 12px 0 0;
  color: #172d23;
  font-size: clamp(24px, 2vw, 31px);
  font-weight: 720;
  letter-spacing: -1.15px;
  line-height: 1.2;
}

.greeting {
  color: #c99a4b;
  font-size: 21px;
}

.welcome-subtitle {
  margin: 10px 0 0;
  color: var(--text-secondary);
  font-size: 12px;
  line-height: 1.7;
}

.welcome-actions {
  display: flex;
  align-items: center;
  gap: 9px;
}

/* Buttons */

.button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  min-height: 39px;
  padding: 0 13px;
  border: 1px solid transparent;
  border-radius: 8px;
  font-size: 11px;
  font-weight: 650;
  white-space: nowrap;
  transition:
    background 150ms ease,
    border-color 150ms ease,
    transform 150ms ease;
}

.button:active {
  transform: translateY(1px);
}

.button-outline {
  color: #40554a;
  background: #ffffff;
  border-color: #e0e7e2;
}

.button-outline:hover {
  background: #f7faf7;
  border-color: #c9d9ce;
}

.button-primary {
  color: #ffffff;
  background: var(--green-800);
  border-color: var(--green-800);
  box-shadow: 0 2px 4px rgb(18 75 54 / 10%);
}

.button-primary:hover {
  background: #10573d;
  border-color: #10573d;
}

/* Demo notification */

.demo-notice {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px 15px;
  margin-bottom: 20px;
  background: #f1f8f3;
  border: 1px solid #e0eee4;
  border-radius: 9px;
}

.demo-notice-icon {
  display: grid;
  flex-shrink: 0;
  width: 32px;
  height: 32px;
  place-items: center;
  color: #20805a;
  background: #e0f1e5;
  border-radius: 8px;
}

.demo-notice strong,
.demo-notice span {
  display: block;
}

.demo-notice strong {
  color: #315b43;
  font-size: 11px;
  font-weight: 700;
}

.demo-notice span {
  margin-top: 4px;
  color: #698574;
  font-size: 10px;
  line-height: 1.5;
}

/* Statistics */

.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 15px;
  margin-bottom: 20px;
}

.stat-card {
  min-width: 0;
  padding: 19px 18px 17px;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 12px;
  box-shadow: 0 2px 7px rgb(22 48 32 / 2%);
  transition:
    box-shadow 180ms ease,
    transform 180ms ease;
}

.stat-card:hover {
  box-shadow: 0 6px 18px rgb(22 48 32 / 5%);
  transform: translateY(-2px);
}

.stat-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
}

.stat-title {
  color: #718077;
  font-size: 10px;
  font-weight: 550;
  line-height: 1.5;
}

.stat-icon {
  display: grid;
  flex-shrink: 0;
  width: 36px;
  height: 36px;
  place-items: center;
  border-radius: 10px;
}

.stat-green {
  color: #198359;
  background: #eaf6ee;
}

.stat-blue {
  color: #377eb6;
  background: #edf5fc;
}

.stat-orange {
  color: #b47a2b;
  background: #fff5e6;
}

.stat-purple {
  color: #8462b4;
  background: #f3eefb;
}

.stat-value {
  overflow-wrap: anywhere;
  margin-top: 15px;
  color: #1d3427;
  font-size: clamp(19px, 1.7vw, 25px);
  font-weight: 730;
  letter-spacing: -0.7px;
  font-variant-numeric: tabular-nums;
}

.stat-bottom {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 6px;
  margin-top: 13px;
}

.stat-change {
  display: inline-flex;
  align-items: center;
  gap: 2px;
  font-size: 10px;
  font-weight: 700;
}

.stat-change.positive {
  color: #17865a;
}

.stat-change.neutral {
  color: #b07b32;
}

.stat-description {
  color: #929d96;
  font-size: 9px;
}

/* Analytics */

.analytics-grid {
  display: grid;
  grid-template-columns: minmax(0, 1.7fr) minmax(245px, 1fr);
  gap: 18px;
  margin-bottom: 26px;
}

.chart-card,
.methods-card,
.transactions-card {
  min-width: 0;
  background: #ffffff;
  border: 1px solid var(--border);
  border-radius: 12px;
  box-shadow: 0 2px 7px rgb(22 48 32 / 2%);
}

.chart-card {
  padding: 22px 22px 17px;
}

.methods-card {
  padding: 22px 20px 18px;
}

.card-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12px;
}

.card-heading h2,
.transactions-heading h2 {
  margin: 0;
  color: #25382d;
  font-size: 13px;
  font-weight: 720;
  letter-spacing: -0.15px;
}

.card-heading p,
.transactions-heading p {
  margin: 6px 0 0;
  color: #8a968e;
  font-size: 10px;
}

.period-select {
  max-width: 120px;
  min-height: 32px;
  padding: 0 8px;
  color: #56685c;
  background: #ffffff;
  border: 1px solid #e5eae6;
  border-radius: 7px;
  font-size: 10px;
}

.chart-summary {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 9px;
  margin-top: 22px;
}

.chart-summary > strong {
  color: #20382a;
  font-size: 22px;
  font-weight: 740;
  letter-spacing: -0.7px;
}

.chart-growth {
  display: inline-flex;
  align-items: center;
  gap: 2px;
  padding: 4px 6px;
  color: #188356;
  background: #eaf6ee;
  border-radius: 5px;
  font-size: 9px;
  font-weight: 700;
}

.chart-summary-label {
  color: #929d96;
  font-size: 9px;
}

.chart-container {
  display: grid;
  grid-template-columns: 30px minmax(0, 1fr);
  gap: 7px;
  margin-top: 22px;
}

.chart-y-labels {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding-bottom: 22px;
  color: #99a49d;
  font-size: 9px;
  text-align: right;
}

.chart-main {
  position: relative;
  min-width: 0;
  height: 177px;
}

.chart-grid {
  position: absolute;
  inset: 0 0 22px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.chart-grid span {
  height: 1px;
  background: #edf1ed;
}

.payment-chart {
  position: absolute;
  inset: 0 0 20px;
  width: 100%;
  height: calc(100% - 20px);
  overflow: visible;
}

.chart-x-labels {
  position: absolute;
  inset: auto 0 0;
  display: flex;
  justify-content: space-between;
  color: #89968e;
  font-size: 9px;
}

.chart-legend {
  display: flex;
  align-items: center;
  gap: 7px;
  margin-top: 11px;
  color: #697a70;
  font-size: 9px;
}

.legend-dot {
  width: 8px;
  height: 8px;
  background: #18875e;
  border-radius: 50%;
}

.chart-legend-note {
  margin-left: auto;
  color: #a1aaa4;
  font-size: 9px;
}

/* Payment method breakdown */

.methods-total {
  display: flex;
  flex-direction: column;
  gap: 5px;
  margin-top: 29px;
}

.methods-total span {
  color: #89958e;
  font-size: 10px;
}

.methods-total strong {
  color: #22392b;
  font-size: 27px;
  font-weight: 740;
  letter-spacing: -0.7px;
}

.method-bar {
  display: flex;
  height: 9px;
  gap: 3px;
  margin-top: 20px;
  overflow: hidden;
  border-radius: 10px;
}

.method-bar span {
  display: block;
  height: 100%;
  border-radius: 5px;
}

.method-mpesa {
  width: 68%;
  background: #16845a;
}

.method-wallet {
  width: 22%;
  background: #8ec9a6;
}

.method-api {
  flex: 1;
  background: #d5e9dc;
}

.method-list {
  display: flex;
  flex-direction: column;
  gap: 17px;
  margin-top: 25px;
}

.method-row,
.method-name {
  display: flex;
  align-items: center;
}

.method-row {
  justify-content: space-between;
  gap: 12px;
}

.method-name {
  gap: 9px;
  color: #617168;
  font-size: 10px;
}

.method-row > strong {
  color: #31463a;
  font-size: 11px;
  font-weight: 700;
}

.method-dot {
  display: inline-block;
  width: 9px;
  height: 9px;
  flex-shrink: 0;
  border-radius: 3px;
}

.method-mpesa-dot {
  background: #16845a;
}

.method-wallet-dot {
  background: #8ec9a6;
}

.method-api-dot {
  background: #d5e9dc;
}

.methods-note {
  display: flex;
  align-items: flex-start;
  gap: 8px;
  padding-top: 14px;
  margin-top: 23px;
  color: #89988e;
  border-top: 1px solid #edf1ed;
  font-size: 9px;
  line-height: 1.6;
}

.methods-note svg {
  flex-shrink: 0;
  color: #759782;
}

/* Transaction table */

.table-search-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15px;
  margin-bottom: 13px;
}

.table-search {
  display: flex;
  align-items: center;
  width: min(100%, 330px);
  height: 38px;
  gap: 9px;
  padding: 0 11px;
  color: #89968d;
  background: #ffffff;
  border: 1px solid #e3e9e4;
  border-radius: 8px;
}

.table-search:focus-within {
  border-color: #8dc7a5;
  box-shadow: 0 0 0 3px rgb(36 135 86 / 7%);
}

.table-search input {
  width: 100%;
  min-width: 0;
  padding: 0;
  color: #2d4235;
  background: transparent;
  border: 0;
  outline: 0;
  font-size: 10px;
}

.table-search input::placeholder {
  color: #a1aaa4;
}

.table-search input:focus-visible {
  outline: none;
}

.table-period {
  color: #89958e;
  font-size: 10px;
}

.transactions-card {
  overflow: hidden;
}

.transactions-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15px;
  padding: 20px 21px;
  border-bottom: 1px solid #edf0ed;
}

.transactions-heading p {
  margin-top: 6px;
}

.table-wrapper {
  width: 100%;
  overflow-x: auto;
}

.transactions-table {
  width: 100%;
  border-collapse: collapse;
  text-align: left;
  white-space: nowrap;
}

.transactions-table th {
  padding: 12px 17px;
  color: #89958e;
  background: #fafbfa;
  border-bottom: 1px solid #edf0ed;
  font-size: 9px;
  font-weight: 650;
}

.transactions-table td {
  padding: 14px 17px;
  color: #46594d;
  border-bottom: 1px solid #f0f2f0;
  font-size: 10px;
}

.transactions-table tbody tr:last-child td {
  border-bottom: 0;
}

.transactions-table tbody tr:hover {
  background: #fbfdfb;
}

.transaction-code,
.customer-cell {
  display: flex;
  align-items: center;
  gap: 10px;
}

.transaction-symbol {
  display: grid;
  flex-shrink: 0;
  width: 31px;
  height: 31px;
  place-items: center;
  color: #218259;
  background: #edf7ef;
  border-radius: 9px;
}

.transaction-code strong,
.transaction-code span,
.customer-cell > span {
  display: block;
}

.transaction-code strong {
  color: #2a4032;
  font-size: 10px;
  font-weight: 700;
}

.transaction-code div > span {
  margin-top: 5px;
  color: #96a199;
  font-size: 9px;
}

.customer-cell > span {
  color: #405347;
  font-size: 10px;
  font-weight: 550;
}

.date-cell {
  color: #87938b !important;
  font-size: 9px !important;
}

.amount-cell {
  color: #263d2f !important;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}

.status {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 6px 8px;
  border-radius: 6px;
  font-size: 9px;
  font-weight: 650;
}

.status-dot {
  width: 6px;
  height: 6px;
  background: currentColor;
  border-radius: 50%;
}

.status-completed {
  color: #188157;
  background: #eaf6ed;
}

.status-pending {
  color: #a97425;
  background: #fff5e3;
}

.status-failed {
  color: #bc5750;
  background: #fff0ee;
}

.row-action {
  width: 29px;
  height: 29px;
  color: #839188;
}

.empty-state {
  padding: 30px !important;
  color: #87938b !important;
  text-align: center;
}

.table-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15px;
  padding: 15px 20px;
  color: #87938b;
  border-top: 1px solid #edf0ed;
  font-size: 10px;
}

.table-footer strong {
  color: #45594c;
}

.text-button {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  padding: 4px 0;
  color: #187a53;
  background: transparent;
  border: 0;
  font-size: 10px;
  font-weight: 700;
}

.text-button:hover {
  color: #10563a;
}

.app-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 23px 2px 0;
  color: #98a39b;
  font-size: 9px;
}

.app-footer > span:last-child {
  display: flex;
  align-items: center;
  gap: 7px;
}

/* Secondary navigation pages */

.placeholder-page {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  min-height: 400px;
  padding: 34px;
  background: #ffffff;
  border: 1px solid var(--border);
  border-radius: 12px;
}

.placeholder-icon {
  display: grid;
  width: 54px;
  height: 54px;
  margin-bottom: 24px;
  place-items: center;
  color: #187b53;
  background: #eaf6ed;
  border-radius: 13px;
}

.placeholder-page h1 {
  margin-top: 10px;
}

.placeholder-page > p {
  max-width: 480px;
  margin: 12px 0 0;
  color: #78867d;
  font-size: 12px;
  line-height: 1.8;
}

.placeholder-notice {
  display: flex;
  align-items: flex-start;
  max-width: 480px;
  gap: 12px;
  padding: 17px;
  margin-top: 28px;
  color: #227750;
  background: #f0f8f2;
  border: 1px solid #e0eee4;
  border-radius: 10px;
}

.placeholder-notice svg {
  flex-shrink: 0;
}

.placeholder-notice strong,
.placeholder-notice span {
  display: block;
}

.placeholder-notice strong {
  color: #315b43;
  font-size: 11px;
}

.placeholder-notice span {
  margin-top: 7px;
  color: #708b79;
  font-size: 10px;
  line-height: 1.7;
}

/* Mobile navigation overlay */

.mobile-overlay {
  display: none;
}

/* Tablet */

@media (max-width: 1200px) {
  .sidebar {
    width: 220px;
  }

  .main-shell {
    margin-left: 220px;
  }

  .page-content {
    padding-right: 25px;
    padding-left: 25px;
  }

  .topbar {
    padding-right: 25px;
    padding-left: 25px;
  }

  .stats-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .analytics-grid {
    grid-template-columns: minmax(0, 1.4fr) minmax(225px, 1fr);
  }
}

/* Small laptops and tablets */

@media (max-width: 900px) {
  .analytics-grid {
    grid-template-columns: 1fr;
  }

  .methods-card {
    padding-bottom: 20px;
  }

  .method-list {
    gap: 13px;
  }

  .methods-note {
    margin-top: 18px;
  }

  .welcome-row {
    align-items: flex-start;
    flex-direction: column;
  }

  .welcome-actions {
    width: 100%;
  }
}

/* Phones */

@media (max-width: 680px) {
  .sidebar {
    width: 260px;
    transform: translateX(-100%);
    transition: transform 220ms ease;
    box-shadow: none;
  }

  .sidebar.sidebar-open {
    transform: translateX(0);
    box-shadow: 10px 0 35px rgb(0 0 0 / 15%);
  }

  .mobile-overlay {
    position: fixed;
    inset: 0;
    z-index: 25;
    display: block;
    width: 100%;
    height: 100%;
    background: rgb(13 35 24 / 45%);
    border: 0;
  }

  .main-shell {
    margin-left: 0;
  }

  .topbar {
    height: 65px;
    padding: 0 17px;
  }

  .mobile-menu {
    display: grid;
    margin-right: 10px;
  }

  .breadcrumbs {
    gap: 7px;
    font-size: 10px;
  }

  .topbar-actions {
    gap: 9px;
  }

  .environment {
    padding: 7px;
    font-size: 0;
  }

  .environment-dot {
    width: 7px;
    height: 7px;
  }

  .notification-button {
    width: 32px;
  }

  .topbar-divider {
    display: none;
  }

  .profile-button {
    gap: 6px;
  }

  .profile-info,
  .profile-button > svg {
    display: none;
  }

  .avatar-admin {
    width: 33px;
    height: 33px;
  }

  .page-content {
    padding: 25px 16px 20px;
  }

  .welcome-row {
    gap: 18px;
    margin-bottom: 20px;
  }

  .welcome-row h1 {
    font-size: 25px;
  }

  .welcome-subtitle {
    font-size: 11px;
  }

  .welcome-actions {
    flex-wrap: wrap;
  }

  .welcome-actions .button {
    flex: 1;
  }

  .demo-notice {
    align-items: flex-start;
  }

  .demo-notice span {
    line-height: 1.7;
  }

  .stats-grid {
    gap: 10px;
    margin-bottom: 15px;
  }

  .stat-card {
    padding: 14px 12px;
    border-radius: 10px;
  }

  .stat-title {
    font-size: 9px;
  }

  .stat-icon {
    width: 30px;
    height: 30px;
  }

  .stat-icon svg {
    width: 17px;
    height: 17px;
  }

  .stat-value {
    margin-top: 13px;
    font-size: clamp(17px, 5vw, 23px);
  }

  .stat-bottom {
    gap: 4px;
    margin-top: 10px;
  }

  .stat-description {
    font-size: 8px;
  }

  .analytics-grid {
    gap: 13px;
    margin-bottom: 22px;
  }

  .chart-card,
  .methods-card {
    padding: 17px 14px;
  }

  .chart-summary > strong {
    font-size: 20px;
  }

  .chart-summary-label {
    width: 100%;
  }

  .chart-container {
    grid-template-columns: 26px minmax(0, 1fr);
    gap: 5px;
  }

  .chart-main {
    height: 160px;
  }

  .chart-legend-note {
    font-size: 8px;
  }

  .table-search-row {
    align-items: flex-start;
    flex-direction: column;
    gap: 9px;
  }

  .table-search {
    width: 100%;
  }

  .transactions-heading {
    padding: 16px 14px;
  }

  .transactions-table th,
  .transactions-table td {
    padding-right: 13px;
    padding-left: 13px;
  }

  .table-footer {
    align-items: flex-start;
    flex-direction: column;
    padding: 14px;
  }

  .app-footer {
    align-items: flex-start;
    flex-direction: column;
    line-height: 1.7;
  }

  .placeholder-page {
    min-height: 350px;
    padding: 23px 17px;
  }
}

/* Respect reduced-motion preferences */

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    scroll-behavior: auto !important;
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}

.brand-mark img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: contain;
  padding: 4px;
}